---
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/usluge" — canonical/OG URL is built from Astro.site + this. */
  path?: string;
  /** Optional per-page OG image; falls back to the site default. */
  ogImage?: string;
}

const { title, description, path = '/', ogImage } = Astro.props;

const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL(ogImage ?? '/og-default.jpg', Astro.site);

const siteName = 'Lovrić Vision';
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicons — simplified transparent-background monogram cropped from the full logo -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Self-hosted fonts: preload the above-the-fold weights (Fraunces 400 for the H1,
         Inter 400 for the hero paragraph). Other weights load lazily via @font-face. -->
    <link rel="preload" href="/fonts/fraunces-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-400-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400-latin-ext.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title} · {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={`${title} · ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="hr_HR" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- LocalBusiness structured data — two locations (Zagreb + Slavonski Brod).
         Placeholder details (phone, OIB-derived identifiers, hours) per the design
         handoff; confirm with the client before relying on this for rich results. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'HomeAndConstructionBusiness',
          '@id': 'https://lovricvision.hr/#zagreb',
          name: 'Lovrić Vision — Zagreb',
          image: ogImageURL.toString(),
          telephone: '+385-1-234-5678',
          email: 'ponude@lovricvision.hr',
          url: 'https://lovricvision.hr',
          priceRange: '€€',
          address: {
            '@type': 'PostalAddress',
            streetAddress: 'Radnička cesta 52',
            addressLocality: 'Zagreb',
            addressCountry: 'HR',
          },
          areaServed: ['Zagreb', 'Zagrebačka županija'],
          openingHoursSpecification: {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
            opens: '08:00',
            closes: '16:00',
          },
        },
        {
          '@type': 'HomeAndConstructionBusiness',
          '@id': 'https://lovricvision.hr/#slavonski-brod',
          name: 'Lovrić Vision — Slavonski Brod',
          image: ogImageURL.toString(),
          telephone: '+385-1-234-5678',
          email: 'ponude@lovricvision.hr',
          url: 'https://lovricvision.hr',
          priceRange: '€€',
          address: {
            '@type': 'PostalAddress',
            streetAddress: 'Osječka 118',
            addressLocality: 'Slavonski Brod',
            addressCountry: 'HR',
          },
          areaServed: ['Slavonija', 'Brodsko-posavska županija', 'Osječko-baranjska županija'],
          openingHoursSpecification: {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
            opens: '08:00',
            closes: '16:00',
          },
        },
      ],
    })} />

    <!-- TODO: Google Tag Manager — paste your container ID (GTM-XXXXXXX) below and
