---
const navLinks = [
  { href: '/#profil', label: 'Stolarija' },
  { href: '/usluge#alu-klizni-sustavi', label: 'Klizni sustavi' },
  { href: '/usluge#plise-komarnici', label: 'Komarnici' },
  { href: '/#projekti', label: 'Projekti' },
  { href: '/kontakt', label: 'Kontakt' },
];

// Mark the current top-level page (used for the two full-page nav targets).
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const base = href.split('#')[0].replace(/\/$/, '') || '/';
  return base !== '/' && path.endsWith(base);
};

const phoneHref = 'tel:+38512345678';
const phoneLabel = '+385 1 234 5678';
---

<header class="site-header">
  <nav class="site-header__nav" aria-label="Glavna navigacija">
    <a href="/" class="site-header__brand" aria-label="Lovrić Vision — početna">
      <span class="wordmark">
        <span class="wordmark__name">Lovrić</span>
        <span class="wordmark__suffix">Vision</span>
      </span>
    </a>

    <!-- DESKTOP NAV -->
    <ul class="site-header__links">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a href={phoneHref} class="site-header__phone">
      <svg
        class="site-header__phone-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
      </svg>
      <span class="site-header__phone-label">{phoneLabel}</span>
    </a>

    <!-- MOBILE HAMBURGER -->
    <button
      class="site-header__menu-toggle"
      type="button"
      aria-label="Otvori izbornik"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu__inner">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-menu__link"
          aria-current={isCurrent(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}

      <a href={phoneHref} class="mobile-menu__phone">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <span>{phoneLabel}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--border-hairline);
  }

  .site-header__nav {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--content-gutter);
    min-height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: clamp(20px, 3vw, 48px);
  }

  /* ---- Wordmark ---- */
  .site-header__brand {
    justify-self: start;
    display: inline-flex;
    text-decoration: none;
    color: var(--text-primary);
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    font-size: clamp(0.9rem, 0.82rem + 0.4vw, 1.05rem);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark__name {
    font-weight: var(--fw-bold);
  }

  .wordmark__suffix {
    font-weight: var(--fw-regular);
    letter-spacing: 0.2em;
  }

  /* ---- Desktop nav (centre column) ---- */
  .site-header__links {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.4vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__links a {
    position: relative;
    display: inline-block;
    padding: 6px 0;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header__links a:hover,
  .site-header__links a:focus-visible {
    color: var(--text-primary);
  }

  .site-header__links a:hover::after,
  .site-header__links a:focus-visible::after,
  .site-header__links a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-header__links a[aria-current='page'] {
    color: var(--text-primary);
  }

  /* ---- Phone pill (right column) ---- */
  .site-header__phone {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 18px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    color: var(--text-primary);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .site-header__phone:hover,
  .site-header__phone:focus-visible {
    background: var(--accent-tint);
    border-color: var(--accent-strong);
  }

  .site-header__phone-icon {
    width: 15px;
    height: 15px;
    color: var(--accent-strong);
    flex-shrink: 0;
  }

  /* ---- Hamburger (hidden on desktop) ---- */
  .site-header__menu-toggle {
    display: none;
    justify-self: end;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 11px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .site-header__menu-toggle span {
    display: block;
    width: 100%;
    height: 1.5px;
    margin: 5px 0;
    background: var(--text-primary);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  /* ---- Mobile menu ---- */
  .mobile-menu {
    display: none;
  }

  /* Tablet: keep the full nav but tighten it, and drop the phone label. */
  @media (max-width: 1080px) {
    .site-header__links {
      gap: clamp(14px, 2vw, 24px);
    }

    .site-header__links a {
      font-size: 0.9rem;
    }

    .site-header__phone {
      padding: 9px;
      gap: 0;
    }

    .site-header__phone-label {
      display: none;
    }

    .site-header__phone-icon {
      width: 17px;
      height: 17px;
    }
  }

  @media (max-width: 900px) {
    .site-header__nav {
      grid-template-columns: 1fr auto;
    }

    .site-header__links,
    .site-header__phone {
      display: none;
    }

    .site-header__menu-toggle {
      display: block;
    }

    .mobile-menu {
      display: block;
      max-height: 0;
      overflow: hidden;
      background: var(--surface-ivory);
      border-top: 1px solid transparent;
      transition: max-height 0.38s ease, border-color 0.38s ease;
    }

    .mobile-menu.is-open {
      max-height: 520px;
      border-top-color: var(--border-hairline);
    }

    .mobile-menu__inner {
      padding: 8px var(--content-gutter) 28px;
      display: flex;
      flex-direction: column;
    }

    .mobile-menu__link {
      padding: 16px 0;
      border-bottom: 1px solid var(--border-hairline);
      font-size: 1.15rem;
      font-weight: var(--fw-medium);
      letter-spacing: 0.01em;
      color: var(--text-primary);
      text-decoration: none;
    }

    .mobile-menu__link[aria-current='page'] {
      color: var(--accent-strong);
    }

    .mobile-menu__phone {
      margin-top: 22px;
      padding: 14px 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border: 1px solid var(--accent);
      border-radius: 999px;
      color: var(--text-primary);
      text-decoration: none;
      font-size: 0.95rem;
      letter-spacing: 0.02em;
    }

    .mobile-menu__phone svg {
      width: 16px;
      height: 16px;
      color: var(--accent-strong);
    }

    .site-header__menu-toggle.is-open span:nth-child(1) {
      transform: translateY(6.5px) rotate(45deg);
    }

    .site-header__menu-toggle.is-open span:nth-child(2) {
      opacity: 0;
    }

    .site-header__menu-toggle.is-open span:nth-child(3) {
      transform: translateY(-6.5px) rotate(-45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__links a::after {
      transition: none;
    }
  }
</style>

<script>
  function initMobileMenu() {
    const button = document.querySelector<HTMLButtonElement>('.site-header__menu-toggle');
    const menu = document.querySelector<HTMLElement>('#mobile-menu');

    if (!button || !menu) return;

    function closeMenu() {
      button.classList.remove('is-open');
      menu.classList.remove('is-open');
      button.setAttribute('aria-expanded', 'false');
    }

    button.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('is-open');
      button.classList.toggle('is-open', isOpen);
      button.setAttribute('aria-expanded', String(isOpen));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) closeMenu();
    });
  }

  initMobileMenu();
</script>
