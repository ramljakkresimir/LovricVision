---
import { Image } from 'astro:assets';
import profilPhoto from '../assets/images/profil-prozor.jpeg';

const features = [
  {
    title: 'Elegant 76 X',
    text: 'Šesterokomorni profil, 76 mm ugradbene dubine. Stabilno krilo koje ostaje ravno i nakon godina rada.',
    side: 'left',
  },
  {
    title: 'Troslojno staklo',
    text: '4/16/4/16/4 s dva low-e sloja i punjenjem argonom. Ug 0,5 W/m²K.',
    side: 'right',
  },
  {
    title: 'Čelično ojačanje',
    text: 'Zatvoreni čelični profil u okviru i krilu — statika za velike staklene površine.',
    side: 'left',
  },
  {
    title: 'Zvučna izolacija',
    text: 'Tri brtvene ravnine i asimetrično staklo prigušuju do 42 dB vanjske buke.',
    side: 'right',
  },
  {
    title: 'Tri brtve',
    text: 'Obodno brtvljenje krila zaustavlja propuh i vlagu prije nego dođu do prostora.',
    side: 'left',
  },
  {
    title: '0,85 W/m²K',
    text: 'Toplinska propusnost cijelog prozora, mjereno s ugradnjom po RAL smjernicama.',
    side: 'right',
  },
];
---

<section id="profil" class="profil">
  <div class="profil__intro">
    <h2>Više od prozora</h2>
    <p>
      Pametni sustavi, vrhunski materijali i precizna ugradnja
      za komfor koji traje godinama.
    </p>
  </div>

  <div class="profil__stage">
    <div class="profil__image">
      <Image
        src={profilPhoto}
        alt="Bočni presjek PVC prozora Elegant 76 X, prikazan otvoren — vidljiv šesterokomorni profil i okov"
        widths={[320, 480, 640, 840]}
        sizes="(max-width: 700px) 42vw, (min-width: 900px) 420px, 30vw"
        format="webp"
        quality={82}
        loading="lazy"
      />
    </div>

    <div class="profil__column">
      {
        features.map((f) => (
          <div class="profil__feat" data-feat data-side={f.side}>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .profil {
    position: relative;
    background: var(--surface-ink);
    color: var(--text-on-ink);
    padding: var(--section-y) 0 var(--section-y);
    overflow: hidden;
  }

  .profil__intro {
    max-width: var(--content-max);
    margin: 0 auto clamp(48px, 9vh, 104px);
    padding: 0 var(--content-gutter);
    text-align: center;
  }

  .profil__intro h2 {
    font-weight: var(--fw-regular);
    font-size: var(--step-3);
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-md);
    color: var(--text-on-ink);
  }

  .profil__intro p {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--text-on-ink-muted);
    margin: 0 auto;
    max-width: 46ch;
  }

  .profil__stage {
    position: relative;
    display: grid;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--content-gutter);
  }

  .profil__image {
    grid-area: 1 / 1;
    justify-self: center;
    width: clamp(160px, 30vw, 420px);
  }

  .profil__image :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .profil__column {
    grid-area: 1 / 1;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(56px, 14vh, 150px);
    padding: clamp(40px, 10vh, 116px) 0;
  }

  .profil__feat {
    width: clamp(
      150px,
      calc(50% - clamp(160px, 30vw, 420px) / 2 - 30px),
      340px
    );
  }

  .profil__feat[data-side='left'] {
    align-self: flex-start;
    text-align: right;
  }

  .profil__feat[data-side='right'] {
    align-self: flex-end;
    text-align: left;
  }

  .profil__feat h3 {
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: var(--step-2);
    line-height: 1.14;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-sm);
    color: var(--text-on-ink);
  }

  .profil__feat p {
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--text-on-ink-muted);
    margin: 0;
  }

  @media (max-width: 768px) {
    .profil {
      padding: var(--section-y-tight) 0;
    }

    .profil__intro {
      margin-bottom: clamp(36px, 7vh, 56px);
    }

    .profil__stage {
      padding: 0 var(--content-gutter);
    }

    .profil__image {
      grid-area: 1 / 1;
      justify-self: start;
      width: min(42vw, 165px);
    }

    .profil__column {
      grid-area: 1 / 1;
      width: 100%;
      height: 100%;
      padding: 24px 0;
      gap: 0;
      justify-content: space-between;
    }

    .profil__feat,
    .profil__feat[data-side='left'],
    .profil__feat[data-side='right'] {
      width: calc(100% - min(42vw, 165px) - 24px);
      align-self: flex-end;
      text-align: left;
    }

    .profil__feat h3 {
      margin-bottom: 6px;
    }
  }

  @media (max-width: 360px) {
    .profil__stage {
      padding: 0 16px;
    }

    .profil__image {
      width: 38vw;
    }

    .profil__feat,
    .profil__feat[data-side='left'],
    .profil__feat[data-side='right'] {
      width: calc(100% - 38vw - 18px);
    }
  }
</style>

<script>
  import { revealEachOnScroll } from '../scripts/motion';

  revealEachOnScroll('#profil [data-feat]', { y: 10 });
</script>
