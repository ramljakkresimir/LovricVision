---
import { Image } from 'astro:assets';
import profilPhoto from '../assets/images/profil-prozor.jpeg';

const features = [
  {
    title: 'Elegant 76 X',
    text: 'Šesterokomorni profil, 76 mm ugradbene dubine. Stabilno krilo koje ostaje ravno i nakon godina rada.',
    side: 'left',
  },
  {
    title: 'Troslojno staklo',
    text: '4/16/4/16/4 s dva low-e sloja i punjenjem argonom. Ug 0,5 W/m²K.',
    side: 'right',
  },
  {
    title: 'Čelično ojačanje',
    text: 'Zatvoreni čelični profil u okviru i krilu — statika za velike staklene površine.',
    side: 'left',
  },
  {
    title: 'Zvučna izolacija',
    text: 'Tri brtvene ravnine i asimetrično staklo prigušuju do 42 dB vanjske buke.',
    side: 'right',
  },
  {
    title: 'Tri brtve',
    text: 'Obodno brtvljenje krila zaustavlja propuh i vlagu prije nego dođu do prostora.',
    side: 'left',
  },
  {
    title: '0,85 W/m²K',
    text: 'Toplinska propusnost cijelog prozora, mjereno s ugradnjom po RAL smjernicama.',
    side: 'right',
  },
];
---

<section id="profil" class="profil">
  <div class="profil__intro">
    <h2>Više od <span class="accent">prozora</span></h2>
    <p>
      Pametni sustavi, vrhunski materijali i precizna ugradnja
      za komfor koji traje godinama.
    </p>
  </div>

  <div class="profil__stage">
    <div class="profil__image">
      <Image
        src={profilPhoto}
        alt="Bočni presjek PVC prozora Elegant 76 X, prikazan otvoren — vidljiv šesterokomorni profil i okov"
        widths={[320, 480, 640, 840]}
        sizes="(max-width: 700px) 42vw, (min-width: 900px) 420px, 30vw"
        format="webp"
        quality={82}
        loading="lazy"
      />
    </div>

    <div class="profil__column">
      {
        features.map((f) => (
          <div
            class="profil__feat"
            data-feat
            data-side={f.side}
          >
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .profil {
    position: relative;
    background: var(--ink);
    color: var(--bone);
    margin-top: 0;
    padding: 40px 0 clamp(70px, 12vh, 130px);
    overflow: hidden;
  }

  .profil__intro {
    max-width: var(--content-max);
    margin: 0 auto clamp(40px, 8vh, 90px);
    padding: 0 var(--content-pad);
    text-align: center;
  }

  .profil__intro h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 4.2vw, 58px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0 0 0 0;
  }

  .profil__intro h2 .accent {
    color: var(--copper);
  }

  .profil__intro p {
    font-size: clamp(14px, 1.2vw, 16.5px);
    line-height: 1.6;
    color: var(--muted-on-ink);
    margin: 0 auto;
    max-width: 46ch;
  }

  .profil__stage {
    position: relative;
    display: grid;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--content-pad);
  }

  /*
   * DESKTOP:
   * Slika je centrirana.
   * Tekstovi su raspoređeni lijevo i desno.
   */
  .profil__image {
    grid-area: 1 / 1;
    justify-self: center;
    width: clamp(160px, 30vw, 420px);
  }

  .profil__image :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .profil__column {
    grid-area: 1 / 1;
    position: relative;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    gap: clamp(60px, 14vh, 160px);
    padding: clamp(40px, 10vh, 120px) 0;
  }

  .profil__feat {
    opacity: 0;
    transform: translateY(16px);

    transition:
      opacity 0.7s ease,
      transform 0.7s ease;

    width: clamp(
      150px,
      calc(50% - clamp(160px, 30vw, 420px) / 2 - 30px),
      340px
    );
  }

  .profil__feat[data-side='left'] {
    align-self: flex-start;
    text-align: right;
  }

  .profil__feat[data-side='right'] {
    align-self: flex-end;
    text-align: left;
  }

  .profil__feat h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.1;

    margin: 0 0 10px;
    color: var(--bone);
  }

  .profil__feat p {
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.6;

    color: var(--muted-on-ink);
    margin: 0;
  }

  /*
   * MOBILE
   *
   * Prozor ide lijevo.
   * SVI tekstovi idu desno.
   * Visina column elementa prati visinu slike.
   */
  @media (max-width: 700px) {
    .profil {
      margin-top: 0;
      padding: 64px 0 72px;
    }

    .profil__intro {
      margin-bottom: 48px;
    }

    .profil__intro h2 {
      font-size: clamp(36px, 11vw, 48px);
    }

    .profil__intro p {
      font-size: 14px;
      max-width: 32ch;
    }

    .profil__stage {
      display: grid;
      padding: 0 20px;
    }

    /*
     * PROZOR LIJEVO
     */
    .profil__image {
      grid-area: 1 / 1;
      justify-self: start;

      width: min(42vw, 165px);
    }

    .profil__image :global(img) {
      width: 100%;
      height: auto;
      display: block;
    }

    /*
     * Tekstualni stupac zauzima istu grid ćeliju
     * i istu visinu kao prozor.
     */
    .profil__column {
      grid-area: 1 / 1;

      width: 100%;
      height: 100%;

      padding: 24px 0;
      gap: 0;

      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /*
     * SVI TEKSTOVI DESNO
     *
     * Ignoriramo desktop data-side left/right
     * i sve ih poravnamo jednako.
     */
    .profil__feat,
    .profil__feat[data-side='left'],
    .profil__feat[data-side='right'] {
      width: calc(100% - min(42vw, 165px) - 24px);

      align-self: flex-end;
      text-align: left;
    }

    .profil__feat h3 {
      font-size: clamp(20px, 5.8vw, 25px);
      margin-bottom: 6px;
    }

    .profil__feat p {
      font-size: 12.5px;
      line-height: 1.5;
    }
  }

  /*
   * Vrlo uski mobiteli.
   * Malo smanjujemo prozor da tekst dobije više prostora.
   */
  @media (max-width: 360px) {
    .profil__stage {
      padding: 0 16px;
    }

    .profil__image {
      width: 38vw;
    }

    .profil__feat,
    .profil__feat[data-side='left'],
    .profil__feat[data-side='right'] {
      width: calc(100% - 38vw - 18px);
    }

    .profil__feat h3 {
      font-size: 19px;
    }

    .profil__feat p {
      font-size: 11.5px;
    }
  }
</style>

<script>
  function initProfilReveal() {
    const reduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    const items =
      document.querySelectorAll<HTMLElement>(
        '#profil [data-feat]'
      );

    if (reduced) {
      items.forEach((el) => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      });

      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;

            target.style.opacity = '1';
            target.style.transform = 'none';

            io.unobserve(target);
          }
        });
      },
      {
        rootMargin: '0px 0px -22% 0px',
      }
    );

    items.forEach((el) => io.observe(el));
  }

  initProfilReveal();
</script>