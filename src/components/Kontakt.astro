---
---

<section id="kontakt" class="kontakt">
  <div class="kontakt__grid">
    <div class="kontakt__aside">
      <h2>Izmjera je besplatna</h2>
      <p class="kontakt__lede">
        Pošaljite nacrt ili samo približne dimenzije. Javljamo se u roku od jednog radnog dana s
        ponudom i terminom izmjere.
      </p>
      <div class="kontakt__info">
        <div>Zagreb — Radnička cesta 52</div>
        <div>Slavonski Brod — Osječka 118</div>
        <div><a href="tel:+38512345678" class="link-underline">+385 1 234 5678</a></div>
        <div><a href="mailto:ponude@lovricvision.hr" class="link-underline">ponude@lovricvision.hr</a></div>
      </div>
    </div>

    <div class="kontakt__form-wrap">
      <div class="kontakt__confirmation" data-confirmation hidden>
        <div class="kontakt__confirmation-title">Upit je zaprimljen</div>
        <p>Hvala. Javljamo se na navedeni kontakt u roku od jednog radnog dana.</p>
      </div>

      <form class="kontakt__form" data-kontakt-form>
        <!--
          TODO: this only fakes success client-side (see the script below). To wire up
          real submissions, replace the fetch stub with a POST to an Astro API route
          (e.g. src/pages/api/kontakt.ts, which can email ponude@lovricvision.hr) or a
          hosted form service like Formspree/Basin. Remember server-side validation —
          the honeypot below only stops the laziest bots, not a determined one.
        -->
        <div class="kontakt__row">
          <label>
            Ime i prezime
            <input type="text" name="ime" autocomplete="name" required />
          </label>
          <label>
            Telefon ili e-mail
            <input type="text" name="kontakt" required />
          </label>
        </div>
        <label>
          Lokacija objekta
          <input type="text" name="lokacija" autocomplete="address-level2" placeholder="Zagreb, Osijek, Slavonski Brod…" />
        </label>
        <label>
          Što vas zanima
          <textarea name="poruka" rows="4" placeholder="Npr. 12 prozora i dvoja balkonska vrata, novogradnja"></textarea>
        </label>

        <!-- Honeypot spam trap: hidden from real visitors via CSS + tabindex/autocomplete
             hints; bots that fill every field trip this and get silently rejected. -->
        <div class="kontakt__honeypot" aria-hidden="true">
          <label>
            Web stranica
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <button type="submit" class="btn btn--primary btn--cta kontakt__submit">
          Pošalji upit <span class="arrow" aria-hidden="true">&#8594;</span>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .kontakt {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--section-y) var(--content-gutter);
  }

  .kontakt__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .kontakt h2 {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--step-3);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-md);
    max-width: 12ch;
  }

  .kontakt__lede {
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 42ch;
    margin: 0 0 var(--space-xl);
  }

  .kontakt__info {
    display: grid;
    gap: var(--space-sm);
    font-size: var(--step-0);
    color: var(--text-secondary);
  }

  .kontakt__form-wrap {
    padding-left: clamp(0px, 4vw, 56px);
    border-left: 1px solid var(--border-hairline);
  }

  .kontakt__confirmation {
    border: 1px solid var(--accent);
    padding: clamp(28px, 4vw, 40px);
    background: var(--accent-tint);
  }

  .kontakt__confirmation-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--fw-medium);
    margin-bottom: var(--space-xs);
  }

  .kontakt__confirmation p {
    font-size: var(--step-0);
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  .kontakt__form {
    display: grid;
    gap: var(--space-lg);
  }

  .kontakt__form[hidden] {
    display: none;
  }

  .kontakt__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: var(--space-lg);
  }

  .kontakt__form label {
    display: grid;
    gap: var(--space-xs);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--text-secondary);
  }

  .kontakt__form input {
    border: none;
    border-bottom: 1px solid var(--border-input);
    background: transparent;
    padding: 10px 0;
    font-size: 16px;
    letter-spacing: normal;
    text-transform: none;
    color: var(--text-primary);
  }

  .kontakt__form input:focus-visible {
    border-bottom-color: var(--accent-strong);
  }

  .kontakt__form textarea {
    border: 1px solid var(--border-input);
    background: transparent;
    padding: 12px;
    font-size: 16px;
    letter-spacing: normal;
    text-transform: none;
    color: var(--text-primary);
    resize: vertical;
  }

  .kontakt__form textarea:focus-visible {
    border-color: var(--accent-strong);
  }

  .kontakt__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .kontakt__submit {
    justify-self: start;
    margin-top: var(--space-xs);
  }

  @media (max-width: 720px) {
    .kontakt__grid {
      grid-template-columns: 1fr;
    }

    .kontakt__form-wrap {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--border-hairline);
      padding-top: var(--space-xl);
    }
  }
</style>

<script>
  function initKontaktForm() {
    const form = document.querySelector<HTMLFormElement>('#kontakt [data-kontakt-form]');
    const confirmation = document.querySelector<HTMLElement>('#kontakt [data-confirmation]');
    if (!form || !confirmation) return;

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      // Honeypot check — a filled-in hidden field means a bot, not a visitor.
      const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
      if (honeypot && honeypot.value.trim() !== '') {
        return;
      }

      // TODO: replace with a real submission, e.g.:
      //   await fetch('/api/kontakt', { method: 'POST', body: new FormData(form) });
      // and only reveal the confirmation state once that resolves successfully.

      form.hidden = true;
      confirmation.hidden = false;
    });
  }

  initKontaktForm();
</script>
