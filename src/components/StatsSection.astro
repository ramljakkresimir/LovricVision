---
const stats = [
  { value: '18 god.', label: 'iskustva u ugradnji' },
  { value: '2 pogona', label: 'Zagreb i Slavonija' },
  { value: '0,85', label: 'W/m²K na Elegant 76 X' },
  { value: '10 god.', label: 'jamstva na okov' },
];
---

<section class="stats" aria-label="Lovrić Vision u brojkama">
  <div class="stats__inner">
    {
      stats.map((stat) => (
        <div class="stats__item">
          <div class="stats__value">{stat.value}</div>
          <div class="stats__label">{stat.label}</div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stats {
    background: var(--surface-ivory);
    border-block: 1px solid var(--border-hairline);
    padding: var(--section-y-tight) var(--content-gutter);
  }

  .stats__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .stats__item {
    padding: 4px clamp(20px, 3vw, 44px);
    border-right: 1px solid var(--border-hairline);
  }

  .stats__item:first-child {
    padding-left: 0;
  }

  .stats__item:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .stats__value {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .stats__label {
    margin-top: var(--space-sm);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    line-height: 1.45;
    color: var(--text-secondary);
  }

  @media (max-width: 820px) {
    .stats__inner {
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(32px, 6vw, 44px) 0;
    }

    .stats__item {
      padding: 0 24px;
    }

    .stats__item:nth-child(odd) {
      padding-left: 0;
    }

    .stats__item:nth-child(even) {
      padding-right: 0;
      border-right: 0;
    }
  }
</style>
