---
const stats = [
  {
    value: '18 god.',
    label: 'iskustva u ugradnji',
  },
  {
    value: '2 pogona',
    label: 'Zagreb i Slavonija',
  },
  {
    value: '0,85',
    label: 'W/m²K na Elegant 76 X',
  },
  {
    value: '10 god.',
    label: 'jamstva na okov',
  },
];
---

<section class="stats" aria-label="Lovrić Vision u brojkama">
  <div class="stats__inner">
    {
      stats.map((stat) => (
        <div class="stats__item">
          <div class="stats__value">{stat.value}</div>

          <div class="stats__label">
            {stat.label}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stats {
    background: var(--bone);

    padding:
      clamp(60px, 9vh, 100px)
      var(--content-pad);
  }

  .stats__inner {
    max-width: var(--content-max);
    margin: 0 auto;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 0;
  }

  .stats__item {
    padding: 8px clamp(20px, 3vw, 42px);

    border-right: 1px solid var(--hairline-on-bone);
  }

  .stats__item:first-child {
    padding-left: 0;
  }

  .stats__item:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .stats__value {
    font-family: var(--font-display);

    font-size: clamp(34px, 4vw, 52px);
    line-height: 1;

    letter-spacing: -0.025em;

    color: var(--ink);
  }

  .stats__label {
    margin-top: 10px;

    font-size: 14px;
    line-height: 1.5;

    color: var(--muted-on-bone);
  }

  @media (max-width: 700px) {
    .stats {
      padding: 64px 20px;
    }

    .stats__inner {
      grid-template-columns: repeat(2, 1fr);

      gap: 36px 0;
    }

    .stats__item {
      padding: 0 20px;

      border-right: 1px solid var(--hairline-on-bone);
    }

    .stats__item:nth-child(odd) {
      padding-left: 0;
    }

    .stats__item:nth-child(even) {
      padding-right: 0;
      border-right: 0;
    }

    .stats__value {
      font-size: clamp(32px, 9vw, 42px);
    }

    .stats__label {
      font-size: 13px;
    }
  }
</style>