---
// Editorial photo-placeholder block — a calm flat panel with a hairline border
// and a monospace note describing the real photo that belongs here (and its
// recommended resolution). Swap the internals for a real <Image>/<picture> later
// and every call site updates in one place.
interface Props {
  caption: string;
  resolution?: string;
  height?: string;
  alt?: string;
}

const { caption, resolution, height, alt } = Astro.props;
---

<div
  class="placeholder"
  style={height ? `--placeholder-height: ${height}` : undefined}
  role="img"
  aria-label={alt ?? caption}
>
  <span class="placeholder__caption">{caption}</span>
  {resolution && <span class="placeholder__res">{resolution}</span>}
</div>

<style>
  .placeholder {
    height: var(--placeholder-height, 240px);
    background: var(--surface-ivory-2);
    border: 1px solid var(--border-hairline);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 16px;
    gap: 12px;
  }

  .placeholder__caption,
  .placeholder__res {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.03em;
    color: var(--mono-on-bone);
    line-height: 1.5;
  }

  .placeholder__res {
    white-space: nowrap;
  }
</style>
