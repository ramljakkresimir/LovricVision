---
import { getProjects } from '../lib/wordpress';

const projects = await getProjects();
const project = projects[0];

const featuredImage =
  project?._embedded?.['wp:featuredmedia']?.[0]?.source_url ?? null;

const details = [
  project?.acf?.detail_image_1,
  project?.acf?.detail_image_2,
  project?.acf?.detail_image_3,
]
  .filter(Boolean)
  .map((image) => {
    if (typeof image === 'string') {
      return {
        url: image,
        alt: project?.title?.rendered ?? '',
      };
    }

    return {
      url: image?.url,
      alt: image?.alt || project?.title?.rendered || '',
    };
  })
  .filter((image) => image.url);
---

<section id="projekti" class="projekti">
  <div class="projekti__inner">
    <header class="projekti__head">
      <h2>Realizirani projekti</h2>
      <p>
        {project.title.rendered}, {project.acf.location} —
        {project.acf.summary}
      </p>
    </header>
  </div>

  <div class="projekti__lead img-reveal" data-projekti-lead>
    {featuredImage && (
      <img
        src={featuredImage}
        alt={project.title.rendered}
        loading="lazy"
      />
    )}
  </div>

  <div class="projekti__inner">
    <div class="projekti__inner">
      <div class="projekti__grid">
        {details.map((image) => (
          <img
            src={image.url}
            alt={image.alt || project.title.rendered}
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .projekti {
    background: var(--surface-ivory);
    color: var(--text-primary);
    border-top: 1px solid var(--border-hairline);
    padding: var(--section-y) 0;
  }

  .projekti__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--content-gutter);
  }

  .projekti__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg) var(--space-2xl);
    margin-bottom: clamp(40px, 6vh, 64px);
  }

  .projekti__head h2 {
    font-size: var(--step-3);
    font-weight: var(--fw-regular);
    margin: 0;
  }

  .projekti__head p {
    font-size: var(--step-0);
    color: var(--text-secondary);
    max-width: 36ch;
    margin: 0;
    line-height: 1.6;
  }

  .projekti__lead {
    max-width: var(--content-max);
    margin: 0 auto clamp(24px, 4vw, 44px);
    padding: 0 var(--content-gutter);
  }

  .projekti__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(16px, 2vw, 24px);
    align-items: start;
  }

  .projekti__lead img {
    width: 100%;
    height: clamp(420px, 60vh, 680px);
    object-fit: cover;
    display: block;
  }

  .projekti__grid img {
    width: 100%;
    height: clamp(220px, 26vw, 360px);
    object-fit: cover;
    display: block;
  }

  @media (max-width: 720px) {
    .projekti__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>

<script>
  import { revealImageOnScroll } from '../scripts/motion';

  revealImageOnScroll('[data-projekti-lead]');
</script>
