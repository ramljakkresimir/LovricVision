---
import Placeholder from './Placeholder.astro';

const detailShots = [
  { caption: 'detalj okova', alt: 'Detalj okova prozora' },
  { caption: 'interijer, Osijek', alt: 'Interijer stana u Osijeku' },
  { caption: 'ugradnja u tijeku', alt: 'Ugradnja prozora u tijeku' },
];
---

<section id="projekti" class="projekti">
  <div class="projekti__inner">
    <header class="projekti__head">
      <h2>Realizirani projekti</h2>
      <p>Obiteljska kuća, Velika Gorica — 24 pozicije, ALU klizna stijena 4,2 m, vanjske žaluzine.</p>
    </header>
  </div>

  <div class="projekti__lead img-reveal" data-projekti-lead>
    <Placeholder
      caption="foto — pročelje kuće, večernje svjetlo"
      resolution="3200 × 1800 px"
      height="min(64vh, 620px)"
      alt="Pročelje kuće, večernje svjetlo"
    />
  </div>

  <div class="projekti__inner">
    <div class="projekti__grid">
      {detailShots.map((shot, i) => (
        <Placeholder
          caption={shot.caption}
          alt={shot.alt}
          height={i === 0 ? 'clamp(220px, 30vw, 340px)' : 'clamp(180px, 24vw, 260px)'}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .projekti {
    background: var(--surface-ivory);
    color: var(--text-primary);
    border-top: 1px solid var(--border-hairline);
    padding: var(--section-y) 0;
  }

  .projekti__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--content-gutter);
  }

  .projekti__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg) var(--space-2xl);
    margin-bottom: clamp(40px, 6vh, 64px);
  }

  .projekti__head h2 {
    font-size: var(--step-3);
    font-weight: var(--fw-regular);
    margin: 0;
  }

  .projekti__head p {
    font-size: var(--step-0);
    color: var(--text-secondary);
    max-width: 36ch;
    margin: 0;
    line-height: 1.6;
  }

  .projekti__lead {
    max-width: var(--content-max);
    margin: 0 auto clamp(24px, 4vw, 44px);
    padding: 0 var(--content-gutter);
  }

  .projekti__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(16px, 2vw, 24px);
    align-items: start;
  }

  @media (max-width: 720px) {
    .projekti__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>

<script>
  import { revealImageOnScroll } from '../scripts/motion';

  revealImageOnScroll('[data-projekti-lead]');
</script>
