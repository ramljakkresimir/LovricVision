---
import heroPhoto from '../assets/images/hero-balkon.jpeg';
---

<section
  id="vrh"
  class="hero"
  style={`--hero-bg: url("${heroPhoto.src}")`}
>
  <div class="hero__overlay"></div>

  <div class="hero__content">
    <div class="hero__intro">
      <h1>
        Preciznost<br />
        u svakom sloju
      </h1>

      <p class="hero__lede">
        PVC i ALU sustavi po mjeri vašeg doma.
      </p>

      <div class="hero__ctas">
        <a href="#kontakt" class="btn hero__btn hero__btn--primary">
          Zatraži ponudu
        </a>

        <a href="#projekti" class="btn hero__btn hero__btn--outline">
          Pogledaj radove
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;

     min-height: 520px;

    display: flex;
    align-items: center;

    background-image: var(--hero-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    overflow: hidden;
  }

  /*
   * Tamni sloj preko fotografije.
   * Potreban da tekst ostane čitljiv bez obzira
   * na svijetle dijelove fotografije.
   */
  .hero__overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(14, 14, 13, 0.82) 0%,
        rgba(14, 14, 13, 0.62) 38%,
        rgba(14, 14, 13, 0.25) 70%,
        rgba(14, 14, 13, 0.12) 100%
      );

    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;

    width: 100%;
    max-width: var(--content-max);

    margin: 0 auto;
    padding:
      clamp(90px, 14vh, 150px)
      var(--content-pad);
  }

  .hero__intro {
    max-width: 680px;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;

    font-size: clamp(48px, 6.5vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.035em;

    color: var(--bone);

    margin: 0 0 28px;
  }

  .hero__lede {
    max-width: 52ch;

    margin: 0 0 38px;

    font-size: clamp(15px, 1.35vw, 18px);
    line-height: 1.65;

    color: rgba(243, 239, 231, 0.85);

    text-wrap: pretty;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /*
   * Hero ima svoju varijantu buttona
   * jer su globalni buttoni napravljeni
   * za svijetlu pozadinu.
   */
  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 50px;

    text-decoration: none;
  }

  .hero__btn--primary {
    background: var(--copper);
    color: var(--bone);
    border: 1px solid var(--copper);
  }

  .hero__btn--primary:hover {
    background: var(--copper-dark);
    border-color: var(--copper-dark);
    color: var(--bone);
    text-decoration: none;
  }

  .hero__btn--outline {
    background: rgba(14, 14, 13, 0.12);

    border: 1px solid rgba(243, 239, 231, 0.7);

    color: var(--bone);

    backdrop-filter: blur(4px);
  }

  .hero__btn--outline:hover {
    background: var(--bone);
    border-color: var(--bone);

    color: var(--ink);

    text-decoration: none;
  }

  @media (max-width: 700px) {
    .hero {
    min-height: 470px; /* skrati cijeli hero */
    background-size: cover;

    /* drži gornji dio slike, reže više s dna */
    background-position: center top;
  }

    .hero__overlay {
      background:
        linear-gradient(
          180deg,
          rgba(14, 14, 13, 0.72) 0%,
          rgba(14, 14, 13, 0.55) 45%,
          rgba(14, 14, 13, 0.78) 100%
        );
    }

    .hero__content {
      display: flex;
      align-items: flex-end;

      min-height: 470px;

      padding:
        70px
        20px
        75px;
    }

    .hero__intro {
      max-width: 100%;
    }

    h1 {
      font-size: clamp(46px, 13vw, 62px);
      margin-bottom: 22px;
    }

    .hero__lede {
      max-width: 38ch;

      font-size: 15px;
      line-height: 1.6;

      margin-bottom: 30px;
    }

    .hero__ctas {
      width: 100%;
    }

    .hero__btn {
      padding: 14px 22px;
    }
  }

  @media (max-width: 420px) {
    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__btn {
      width: 100%;
    }
  }
</style>