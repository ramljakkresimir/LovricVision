---
import { Image } from 'astro:assets';
import heroHouse from '../assets/images/Hero-house.png';
---

<section id="vrh" class="hero">
  <div class="hero__media img-reveal" data-hero-image>
    <Image
      src={heroHouse}
      alt="Svijetli dnevni boravak s crnom PVC balkonskom stijenom otvorenom prema terasi i pogledu na more"
      widths={[768, 1024, 1440, 1920, 2400]}
      sizes="(max-width: 768px) 100vw, 66vw"
      format="webp"
      quality={72}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__media-scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      <span class="hero__rule" aria-hidden="true"></span>

      <h1 class="hero__title" data-hero-copy>
        <span class="reveal-mask"><span class="reveal-mask__inner">PVC stolarija koja donosi</span></span>
        <span class="reveal-mask"><span class="reveal-mask__inner">više svjetla, topline i udobnosti</span></span>
        <span class="reveal-mask"><span class="reveal-mask__inner">u svaki dom.</span></span>
      </h1>

      <span class="reveal-mask" data-hero-cta>
        <a href="/kontakt" class="btn btn--primary btn--cta hero__cta">
          Zatražite ponudu <span class="arrow" aria-hidden="true">&#8594;</span>
        </a>
      </span>
    </div>
  </div>

  <div class="hero__statement" aria-hidden="true">
    <div class="hero__statement-track">
      <div class="hero__statement-inner" data-hero-statement-inner>
        <span class="hero__statement-a">Preciznost </span><span class="hero__statement-b">u svakom okviru</span>
      </div>
    </div>
  </div>

  <h2 class="visually-hidden">Preciznost u svakom okviru</h2>
</section>

<style>
  .hero {
    --fade-x: 42%;
    position: relative;
    min-height: clamp(600px, 88vh, 880px);
    background: var(--surface-ivory);
    overflow: clip;
  }

  /* ---- Photograph: dominant on the right, feathered into ivory on the left ---- */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      transparent calc(var(--fade-x) - 8%),
      #000 calc(var(--fade-x) + 6%),
      #000 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      transparent calc(var(--fade-x) - 8%),
      #000 calc(var(--fade-x) + 6%),
      #000 100%
    );
  }

  /* No mask support → a plain ivory overlay gives the same left-dissolve. */
  @supports not (mask-image: linear-gradient(#000, #000)) {
    .hero__media::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        var(--surface-ivory) 0%,
        var(--surface-ivory) calc(var(--fade-x) - 8%),
        transparent calc(var(--fade-x) + 8%)
      );
      z-index: 1;
    }
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
  }

  /* Restrained bottom scrim — the photo floor is pale here; this is what keeps the
     light half of the statement legible (matches the reference's result). */
  .hero__media-scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42%;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--surface-ink) 44%, transparent) 0%,
      color-mix(in srgb, var(--surface-ink) 16%, transparent) 45%,
      transparent 100%
    );
  }

  /* ---- Left content in the upper negative space ---- */
  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--content-gutter);
    min-height: inherit;
    display: grid;
    align-content: start;
  }

  .hero__content {
    margin-top: clamp(84px, 16vh, 172px);
    max-width: min(32ch, 40vw);
  }

  .hero__rule {
    display: block;
    width: 60px;
    height: 2px;
    background: var(--accent);
    margin-bottom: clamp(20px, 3vw, 30px);
    transform-origin: left center;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(1.15rem, 0.82rem + 1.4vw, 1.82rem);
    line-height: 1.36;
    letter-spacing: -0.011em;
    color: var(--text-primary);
    margin: 0;
  }

  [data-hero-cta] {
    margin-top: clamp(26px, 4vw, 38px);
  }

  /* ---- Oversized bottom statement ---- */
  .hero__statement {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(10px, 3.5vh, 46px);
    z-index: 3;
    overflow: clip;
    pointer-events: none;
  }

  /* Sizing frame: left edge aligns with the hero content column, right edge
     stops one gutter short of the viewport edge — the reference composition. */
  .hero__statement-track {
    margin-left: var(--edge-left);
    margin-right: var(--content-gutter);
    container-type: inline-size;
  }

  /* The line. font-size scales to the track (cqw), so the whole phrase always
     fits with margin to spare — never pushed off-screen or clipped — while
     staying oversized. This element is the masked-reveal mover. */
  .hero__statement-inner {
    position: relative;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(2.5rem, 6vw, 6.5rem); /* fallback if container queries unsupported */
    font-size: var(--hero-statement);
    line-height: 0.9;
    letter-spacing: var(--tracking-statement);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Two spans → the dark/light boundary is the word gap after "PRECIZNOST",
     never through a glyph. Everything from "U SVAKOM OKVIRU" onward (incl. the
     final "U") is the light colour; only "PRECIZNOST" is dark, and it stays on
     the ivory side. */
  .hero__statement-a {
    color: var(--text-primary);
  }

  .hero__statement-b {
    color: var(--surface-ivory);
  }

  /* ---------- Tablet: keep the desktop composition, tighten it ---------- */
  @media (max-width: 1024px) {
    .hero {
      --fade-x: 44%;
      min-height: clamp(520px, 76vh, 700px);
    }

    .hero__content {
      max-width: min(52vw, 32ch);
      margin-top: clamp(72px, 13vh, 124px);
    }
  }

  /* ---------- Mobile: bespoke stacked composition ---------- */
  @media (max-width: 768px) {
    .hero {
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow-x: clip;
    }

    .hero__media {
      position: relative;
      order: 1;
      height: 52vh;
      min-height: 320px;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero__media :global(img) {
      object-position: 66% center;
    }

    .hero__media-scrim {
      height: 30%;
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--surface-ink) 26%, transparent) 0%,
        transparent 100%
      );
    }

    .hero__statement {
      position: static;
      order: 2;
      overflow: clip;
      bottom: auto;
      padding: clamp(20px, 6vw, 32px) var(--content-gutter) 0;
    }

    .hero__statement-track {
      margin-inline: 0;
    }

    .hero__statement-inner {
      white-space: normal;
      font-size: clamp(1.85rem, 9cqw, 3rem);
      line-height: 0.98;
      text-wrap: balance;
    }

    /* On mobile the statement sits on ivory (no photo behind) — all one colour. */
    .hero__statement-b {
      color: var(--text-primary);
    }

    .hero__inner {
      position: static;
      order: 3;
      min-height: 0;
      display: block;
    }

    .hero__content {
      margin-top: clamp(22px, 6vw, 36px);
      padding-bottom: clamp(30px, 8vw, 48px);
      max-width: none;
    }

    .hero__title {
      font-size: clamp(1.3rem, 5vw, 1.85rem);
      line-height: 1.36;
    }

    .hero__cta {
      width: 100%;
    }
  }

  @media (max-width: 375px) {
    .hero__media {
      height: 46vh;
      min-height: 280px;
    }

    .hero__statement-inner {
      font-size: clamp(1.7rem, 11cqw, 2.5rem);
    }
  }
</style>

<script>
  import { revealHero } from '../scripts/motion';

  revealHero();
</script>
